{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Module Schema",
  "description": "Defines modules and their section types (video, zoom, materials, assessment)",
  "type": "object",
  "definitions": {
    "Module": {
      "type": "object",
      "required": ["id", "title"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique module identifier"
        },
        "title": {
          "type": "string",
          "description": "Module title"
        },
        "description": {
          "type": "string",
          "description": "Module description"
        },
        "status": {
          "type": "string",
          "enum": ["locked", "unlocked", "completed"],
          "description": "Module access status"
        },
        "sections": {
          "type": "array",
          "items": {
            "oneOf": [
              { "$ref": "#/definitions/VideoSection" },
              { "$ref": "#/definitions/ZoomSection" },
              { "$ref": "#/definitions/MaterialsSection" },
              { "$ref": "#/definitions/AssessmentSection" }
            ]
          },
          "description": "List of sections in this module"
        }
      }
    },
    "VideoSection": {
      "type": "object",
      "properties": {
        "type": {
          "const": "video",
          "description": "Section type identifier"
        },
        "id": {
          "type": "string",
          "description": "Section ID"
        },
        "title": {
          "type": "string",
          "description": "Section title"
        },
        "videoUrl": {
          "type": "string",
          "description": "URL to the video"
        },
        "durationString": {
          "type": "string",
          "description": "Video duration (e.g., '45:30')"
        }
      },
      "required": ["type", "videoUrl"]
    },
    "ZoomSection": {
      "type": "object",
      "properties": {
        "type": {
          "const": "zoom",
          "description": "Section type identifier"
        },
        "id": {
          "type": "string",
          "description": "Section ID"
        },
        "title": {
          "type": "string",
          "description": "Section title"
        },
        "meetingId": {
          "type": "string",
          "description": "Zoom meeting ID"
        },
        "startTime": {
          "type": "string",
          "format": "date-time",
          "description": "Meeting start time"
        },
        "durationString": {
          "type": "string",
          "description": "Meeting duration (e.g., '1:30')"
        },
        "joinLink": {
          "type": "string",
          "description": "Meeting join link"
        }
      },
      "required": ["type", "meetingId"]
    },
    "MaterialsSection": {
      "type": "object",
      "properties": {
        "type": {
          "const": "materials",
          "description": "Section type identifier"
        },
        "id": {
          "type": "string",
          "description": "Section ID"
        },
        "title": {
          "type": "string",
          "description": "Section title"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "File name"
              },
              "type": {
                "type": "string",
                "description": "File type (pdf, doc, etc.)"
              },
              "url": {
                "type": "string",
                "description": "File download URL"
              }
            }
          },
          "description": "List of downloadable files"
        }
      },
      "required": ["type", "files"]
    },
    "AssessmentSection": {
      "type": "object",
      "properties": {
        "type": {
          "const": "assessment",
          "description": "Section type identifier"
        },
        "id": {
          "type": "string",
          "description": "Section ID"
        },
        "title": {
          "type": "string",
          "description": "Section title"
        },
        "assessmentId": {
          "type": "string",
          "description": "Reference to assessment schema"
        },
        "instructions": {
          "type": "string",
          "description": "Assessment instructions"
        },
        "buttonText": {
          "type": "string",
          "description": "CTA button text"
        }
      },
      "required": ["type", "assessmentId"]
    }
  }
}
