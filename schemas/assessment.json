{
  "title": "Assessment form",
  "description": "Each student fiils up an assessment form at the beggining of each lesson. Based on the response, teachers evaluate the students group or category.",
  "type": "object",
  "definitions": {
    "Assessment": {
      "type": "object",
      "required": ["id", "title"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique assessment identifier"
        },
        "title": {
          "type": "string",
          "description": "Assessment title"
        },
        "description": {
          "type": "string",
          "description": "Assessment description"
        },
        "instructions": {
          "type": "string",
          "description": "Specific scoring/filling instructions"
        },
        "questions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/question"
          },
          "description": "Groups of questions in this assessment"
        }
      }
    },
    "question": {
      "type": "object",
      "required": ["id", "title", "options"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique group identifier"
        },
        "title": {
          "type": "string",
          "description": "Group title"
        },
        "questions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/option"
          },
          "description": "List of question in this group"
        }
      }
    },
    "option": {
      "type": "object",
      "required": ["id", "text"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique question identifier"
        },
        "text": {
          "type": "string",
          "description": "Question text"
        },
        "type": {
          "type": "string",
          "enum": ["checkbox", "mcq", "textbox"],
          "description": "Question type: checkbox (multiple choice), mcq (single choice), textbox (open-ended)"
        }
      }
    }
  }
}
