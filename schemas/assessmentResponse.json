{
  "title": "Assessment form Response",
  "description": "stores user responses of the assessment form and result",
  "type": "object",
  "definitions": {
    "AssessmentResponse": {
      "type": "object",
      "required": ["id", "assessmentId", "userId", "answers"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique submitted response form identifier"
        },
        "assessmentId": {
          "type": "string",
          "description": "ID of the assessment being answered"
        },
        "userId": {
          "type": "string",
          "description": "ID of the user submitting the response"
        },
        "submittedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the answer was submitted"
        },
        "answers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "questionId": { "type": "string" },
              "value": { "type": ["string", "boolean", "number"] }
            }
          },
          "description": "User's answers to the individual questions"
        },
        "result": {
          "type": "object",
          "assigned group": { "type": "number" },
          "description": "result of the response."
        }
      }
    }
  }
}