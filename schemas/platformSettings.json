{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Platform Settings Schema",
  "description": "Defines platform-level settings for branding and access control",
  "type": "object",
  "definitions": {
    "PlatformSettings": {
      "type": "object",
      "properties": {
        "branding": {
          "$ref": "#/definitions/Branding",
          "description": "Branding configuration"
        },
        "accessControl": {
          "$ref": "#/definitions/AccessControl",
          "description": "Access control configuration"
        }
      }
    },
    "Branding": {
      "type": "object",
      "properties": {
        "logo": {
          "type": "string",
          "description": "Logo image URL"
        },
        "primaryColor": {
          "type": "string",
          "description": "Primary brand color (hex code)"
        },
        "secondaryColor": {
          "type": "string",
          "description": "Secondary brand color (hex code)"
        }
      }
    },
    "AccessControl": {
      "type": "object",
      "properties": {
        "allowAccessCodes": {
          "type": "boolean",
          "description": "Whether to allow enrollment via access codes"
        },
        "allowUserAccounts": {
          "type": "boolean",
          "description": "Whether to allow user account creation"
        }
      }
    }
  }
}
