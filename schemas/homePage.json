{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Home Page Schema",
  "description": "Defines home page structure including hero banner, instructor info, and community links",
  "type": "object",
  "definitions": {
    "HomePage": {
      "type": "object",
      "properties": {
        "heroBanner": {
          "$ref": "#/definitions/HeroBanner",
          "description": "Hero banner section"
        },
        "instructor": {
          "$ref": "#/definitions/InstructorInfo",
          "description": "Instructor information section"
        },
        "community": {
          "$ref": "#/definitions/CommunityLinks",
          "description": "Community and discussion links"
        },
        "featuredCourses": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "IDs of featured courses"
        },
        "announcements": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Announcement"
          },
          "description": "Platform announcements"
        }
      }
    },
    "HeroBanner": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Banner title"
        },
        "subtitle": {
          "type": "string",
          "description": "Banner subtitle"
        },
        "image": {
          "type": "string",
          "description": "Banner image URL"
        }
      }
    },
    "InstructorInfo": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Instructor's full name"
        },
        "title": {
          "type": "string",
          "description": "Instructor's title/position"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Instructor's email"
        },
        "officeHours": {
          "type": "string",
          "description": "Office hours information"
        },
        "photoUrl": {
          "type": "string",
          "description": "Instructor's profile photo URL"
        }
      }
    },
    "CommunityLinks": {
      "type": "object",
      "properties": {
        "discordLink": {
          "type": "string",
          "description": "Discord community link"
        },
        "discussionLink": {
          "type": "string",
          "description": "Discussion forum link"
        },
        "description": {
          "type": "string",
          "description": "Community description"
        }
      }
    },
    "Announcement": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Announcement title"
        },
        "content": {
          "type": "string",
          "description": "Announcement content"
        },
        "date": {
          "type": "string",
          "format": "date-time",
          "description": "Announcement date"
        }
      }
    }
  }
}
