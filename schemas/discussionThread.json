{
  "title": "Discussion/chat",
  "description": "Defines discussion threads and messages for collaborative learning",
  "type": "object",
  "definitions": {
    "DiscussionThread": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique thread identifier"
        },
        "title": {
          "type": "string",
          "description": "Thread title"
        },
        "messages": {
          "type": "array",
          "items": {
            "$ref": "discussion.json#/DiscussionMessage"
          },
          "description": "Messages in this thread"
        }
      }
    }
  }
}
